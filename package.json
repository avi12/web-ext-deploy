{
  "name": "web-ext-deploy",
  "version": "1.1.3",
  "description": "A tool for deploying WebExtensions to multiple stores.",
  "keywords": [
    "chrome-deploy",
    "chrome-extension",
    "chrome-publish",
    "edge-deploy",
    "edge-extension",
    "edge-publish",
    "edge-publish-api",
    "firefox-addon",
    "firefox-deploy",
    "firefox-extension",
    "firefox-publish",
    "firefox-submission-api",
    "opera-addon",
    "opera-deploy",
    "opera-extension",
    "opera-publish",
    "web-ext",
    "web-ext-deploy",
    "web-ext-publish"
  ],
  "homepage": "https://github.com/avi12/web-ext-deploy#readme",
  "bugs": {
    "url": "https://github.com/avi12/web-ext-deploy/issues",
    "email": "avi6106@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Avi",
    "email": "avi6106@gmail.com",
    "url": "https://avi12.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avi12/web-ext-deploy"
  },
  "funding": [
    {
      "type": "PayPal",
      "url": "https://paypal.me/avi12"
    },
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/avi12"
    }
  ],
  "bin": {
    "web-ext-deploy": "dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "types": "./dist/cli.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "scripts": {
    "debug:dev": "nodemon --watch src --ext ts --exec \"pnpm build\"",
    "clean": "rimraf dist",
    "prepare": "pnpm clean && pnpm build",
    "build": "pnpm build:esm",
    "build:esm": "tsc && tsc-alias -p tsconfig.json",
    "watch": "tsc --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reinstall-locally": "pnpm unlink -g && pnpm i && pnpm link -g",
    "lint": "avi12-lint",
    "lint:fix": "avi12-lint --fix"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ink": "^7.0.5",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "avi12-lint": "github:avi12/lint-config#v0.4.10&path:/packages/avi12-lint",
    "fallow": "^2.89.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/fallow-config",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/oxfmt-config",
    "oxlint": "^1.93.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-plugin-naming",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
