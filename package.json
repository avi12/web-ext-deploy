{
  "name": "web-ext-deploy",
  "version": "0.14.3",
  "description": "A tool for deploying WebExtensions to multiple stores.",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist-esm/*.d.ts"
      ]
    }
  },
  "bin": {
    "web-ext-deploy": "dist-esm/index.js"
  },
  "types": "./dist-esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/avi12/web-ext-deploy"
  },
  "keywords": [
    "web-ext",
    "web-ext-deploy",
    "web-ext-publish",
    "chrome-deploy",
    "chrome-publish",
    "chrome-extension",
    "firefox-deploy",
    "firefox-publish",
    "firefox-extension",
    "firefox-addon",
    "firefox-submission-api",
    "opera-deploy",
    "opera-publish",
    "opera-extension",
    "opera-addon",
    "edge-deploy",
    "edge-publish",
    "edge-extension",
    "edge-publish-api"
  ],
  "files": [
    "dist-esm/**/*"
  ],
  "funding": [
    {
      "type": "PayPal",
      "url": "https://paypal.me/avi12"
    },
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/avi12"
    }
  ],
  "author": {
    "name": "Avi",
    "email": "avi6106@gmail.com",
    "url": "https://avi12.com"
  },
  "bugs": {
    "email": "avi6106@gmail.com",
    "url": "https://github.com/avi12/web-ext-deploy/issues"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/avi12/web-ext-deploy#readme",
  "scripts": {
    "debug:dev": "nodemon --watch src --ext ts --exec \"pnpm build\"",
    "clean": "rimraf dist-esm",
    "prepare": "pnpm clean && pnpm build",
    "build": "pnpm build:esm",
    "build:esm": "tsc",
    "watch": "tsc --watch",
    "types:check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "reinstall-locally": "pnpm unlink -g && pnpm i && pnpm link -g",
    "chrome:token": "tsx scripts/get-chrome-refresh-token.tsx --"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm lint:fix",
      "git add"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^25.3.0",
    "@types/yargs": "^17.0.35",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.1",
    "eslint-plugin-perfectionist": "^5.6.0",
    "globals": "^17.3.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.21",
    "ink": "^6.8.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  }
}
