{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/lint-config/packages/oxlint-config/oxlint.json",
    "./node_modules/lint-config/packages/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "id-length": [
      "error",
      {
        "min": 3,
        "exceptions": ["_", "i", "j", "x", "y", "id", "to", "on", "ok", "T", "z", "fs", "os"],
        "properties": "never"
      }
    ],
    "naming/convention": [
      "error",
      {
        "allowedNames": [
          {
            "reason": "Node ESM replacement for the CommonJS global",
            "names": ["__dirname"]
          }
        ],
        "allowedPatterns": [
          {
            "reason": "The store HTTP APIs (OAuth, AMO, Edge, Opera) and extension manifests spell fields in snake_case",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$"
          },
          {
            "reason": "Option bags keyed by the yargs-style positional array",
            "pattern": "^_$"
          }
        ],
        "fileOverrides": [
          {
            "reason": "Ink components are PascalCase functions, which JSX requires; allowedNames is not honored for function declarations (lint-config defect)",
            "files": ["src/ui/ink-logger.tsx", "src/stores/chrome/chrome-credentials.tsx"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "dist-ext/**", "tests/fixtures/**"]
}
