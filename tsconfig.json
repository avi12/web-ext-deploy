{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "strictNullChecks": false,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["src"]
}
